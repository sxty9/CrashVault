# CrashVault environment — copy to .env and fill in. NEVER commit the real .env.
#
# On the Ubuntu server these are loaded two ways:
#   - systemd EnvironmentFile=.../.env  (the running service)
#   - server.js's own .env loader        (when run directly, e.g. local dev)
# Real environment variables always win over .env.

# Session signing secret, 32+ chars. Generate with: openssl rand -hex 32
# Changing it logs everyone out (accounts.json passwords still work).
JWT_SECRET=replace-with-64-char-hex-from-openssl-rand

# Port the Node process listens on (127.0.0.1 only — cloudflared proxies to it).
PORT=29927
HOST=127.0.0.1

# Where all persistent data lives on the server disk (users, vaults, tiles,
# uploads). Optional — defaults to /var/lib/crashvault. The repo holds only code.
# CRASHVAULT_DATA_DIR=/var/lib/crashvault

# --- AI material import (Phase 1, optional until enabled) ---
# CrashVault shells out to the local `claude` CLI for analysis. Defaults shown.
# CLAUDE_BIN=/home/nanu/.npm-global/bin/claude
# CLAUDE_HOME=/home/nanu
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT_MS=120000
# INGEST_CONFIDENCE_THRESHOLD=0.65
